# Database (Neon)
# DATABASE_URL: pooled connection string used by the application (serverless-friendly)
DATABASE_URL="postgresql://user:password@ep-xxx.region.neon.tech/icedtea?sslmode=require&pooler=true"
# DIRECT_URL: direct (non-pooled) connection string used by Prisma migrations
DIRECT_URL="postgresql://user:password@ep-xxx.region.neon.tech/icedtea?sslmode=require"

# Authentication
# Secret used to sign/verify JWT access tokens. Generate with: openssl rand -base64 32
JWT_SECRET="replace-with-a-strong-random-secret"
# Access token lifetime in seconds. Must not exceed an account's valid_until window.
JWT_EXPIRES_IN="900"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
